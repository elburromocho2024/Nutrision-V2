rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "diegovargas.ch@gmail.com" && request.auth.token.email_verified == true));
    }

    // Domain Validators
    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             (!('age' in data) || data.age is int) &&
             (!('weight' in data) || data.weight is number) &&
             (!('height' in data) || data.height is number);
    }

    function isValidMealPlan(data) {
      return data.uid is string &&
             data.planData is map;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data);
      
      match /mealPlans/{planId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAuthenticated() && isOwner(userId) && isValidMealPlan(request.resource.data);
        allow update: if isAuthenticated() && isOwner(userId) && isValidMealPlan(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
